# ── DATABASE ──────────────────────────────────────────────────
# Local PostgreSQL example:
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/spherechat"
# Railway example:
# DATABASE_URL="postgresql://postgres:xxx@containers-us-west-xxx.railway.app:7777/railway"

# ── REDIS ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT SECRET ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# ── TWILIO (OTP SMS) ──────────────────────────────────────────
# Get free trial at twilio.com
# If left as placeholder, OTPs print to terminal instead of SMS (dev mode)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ── ANTHROPIC (AI MODERATION) ─────────────────────────────────
# Get key at console.anthropic.com
# If left as placeholder, moderation is skipped (app still works)
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── SERVER ────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
